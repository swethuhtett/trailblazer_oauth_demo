<h1>New Post</h1>

<%= form_with model: @form, scope: :post, url: posts_path, local: true do |form| %>
  <p>
    <%= form.label :title %><br>
    <%= form.text_field :title, value: form.object.title %>
    <%= @form.errors[:title].join(", ") if @form.errors[:title].any? %>
  </p>

  <p>
    <%= form.label :content %><br>
    <%= form.text_area :content, value: form.object.content %>
    <%= @form.errors[:content].join(", ") if @form.errors[:content].any? %>
  </p>

  <p><%= form.submit "Create Post" %></p>
<% end %>

<%= link_to "Back", posts_path %>
